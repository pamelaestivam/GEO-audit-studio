# Copy to .env.local for local development. Never commit real keys.
# An engine is only queried when its key is set; a missing key means the engine
# is reported as "not measured", never simulated by another model. ChatGPT,
# Perplexity and Claude are PAID: a key alone is ignored unless ALLOW_PAID_ENGINES=1.
# Full deployment guide: docs/DEPLOYMENT.md

# --- Answer engines ---------------------------------------------------------
# Required - Gemini also writes the qualitative analysis (TECH_DEBT.md 1.2).
GEMINI_API_KEY=""
# Optional extra PAID engines (need ALLOW_PAID_ENGINES=1). Each one multiplies per-audit spend.
# ALLOW_PAID_ENGINES=1
# Optional: the most Gemini calls this server process makes per UTC day (a brake against loops, not a $0 guarantee).
# GEMINI_DAILY_CALL_CAP=200   (a set but unreadable value, including 0, BLOCKS every Gemini call; unset means no cap)
PERPLEXITY_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
# Optional model overrides (no code change needed).
# GEMINI_MODEL=
# OPENAI_MODEL=
# PERPLEXITY_MODEL=
# ANTHROPIC_MODEL=

# --- Sign-in (required in production; the server refuses everyone without it)
# 32+ random characters. Rotating it signs everyone out.  e.g. `openssl rand -hex 32`
SESSION_SECRET=""
# label=code pairs, comma-separated. The label is who the code belongs to - saved
# audits belong to (label, email), so people on different codes cannot see each
# other's work. Codes are 8+ characters and must not contain "," (a code may
# contain "=" if it has a label, e.g. anna=abc...==). Daily budgets are counted
# per CODE, so people who share a code share an allowance.
#   ACCESS_CODES="anna=7Kx9mQ2vLp,ben=4Tz8pL1wQa"
ACCESS_CODES=""
# SESSION_TTL_HOURS=168
# Local development only: `npm run dev` accepts the code "dev-access" from this
# machine when no codes are configured. It is never honoured in production.
# ALLOW_DEV_AUTH=1

# --- Storage -----------------------------------------------------------------
# Directory for the SQLite database. Unset = nothing is saved across restarts.
# `npm run dev` defaults to ./data. In Docker/Render, point it at a persistent volume.
# DATA_DIR=./data

# --- Cost and abuse guards ---------------------------------------------------
# MAX_AUDIT_QUERIES=8          # queries per audit
# MAX_CONCURRENT_AUDITS=2      # audits running at once; more share one quota
# USER_AUDITS_PER_DAY=10       # rolling 24h per person (0 = off)
# GLOBAL_AUDITS_PER_DAY=100    # rolling 24h for everyone (0 = off)
# USER_LOOKUPS_PER_HOUR=30     # brand detection / query suggestions / added queries (per process)
# RATE_LIMIT_PER_MIN=30        # POSTs per IP per minute under /api/audit (0 = off)
# AUTH_RATE_LIMIT_PER_MIN=10   # sign-in attempts per IP per minute (0 = off)
# GEMINI_MIN_INTERVAL_MS=6500  # pacing between Gemini calls (free tier ~10 RPM)

# --- Network -----------------------------------------------------------------
# How many reverse proxies sit in front of the server (1 on Render/Fly/behind
# nginx). 0 (the default) means client-supplied X-Forwarded-For is ignored.
# TRUST_PROXY=0
